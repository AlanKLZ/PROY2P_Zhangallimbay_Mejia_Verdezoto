<?xml version="1.0" encoding="utf-8"?>

<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- IMAGEN SUPERIOR -->
        <ImageView
            android:id="@+id/imgDecoracionSuperior"
            android:layout_width="match_parent"
            android:layout_height="145dp"
            android:contentDescription="Decoración superior"
            android:scaleType="centerCrop"
            android:src="@drawable/decoracion_superior" />

        <!-- DATOS DEL USUARIO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <ImageView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:contentDescription="Usuario"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="#2196F3" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:gravity="center"
                android:text="Bienvenido,"
                android:textColor="#2196F3"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/txtNombreUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Juan Pérez"
                android:textColor="#2196F3"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTipoUsuario"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Participante"
                android:textColor="#F5A623"
                android:textSize="12sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- LÍNEA AZUL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="3"
                android:background="#2196F3" />

            <View
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#64B5F6" />

        </LinearLayout>

        <!-- MENÚ PRINCIPAL -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="Menú principal"
                android:textColor="#2196F3"
                android:textSize="18sp"
                android:textStyle="bold" />

            <!-- MENÚ PARTICIPANTE -->
            <LinearLayout
                android:id="@+id/layoutParticipante"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible">

                <!-- TABLA DE POSICIONES -->
                <LinearLayout
                    android:id="@+id/opcionTablaPosiciones"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_menu_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Tabla de posiciones"
                        android:src="@drawable/ic_trophy"
                        app:tint="#F5A623" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Tabla de posiciones"
                        android:textColor="#2196F3"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#2196F3" />

                </LinearLayout>

                <!-- PRONÓSTICOS -->
                <LinearLayout
                    android:id="@+id/opcionPronosticos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_menu_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Pronósticos"
                        android:src="@drawable/ic_soccer"
                        app:tint="#16A7D3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Pronósticos"
                        android:textColor="#2196F3"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#2196F3" />

                </LinearLayout>

                <!-- MIS PRONÓSTICOS -->
                <LinearLayout
                    android:id="@+id/opcionMisPronosticos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_menu_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Mis pronósticos"
                        android:src="@drawable/ic_clipboard"
                        app:tint="#EC168C" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Mis pronósticos"
                        android:textColor="#2196F3"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#2196F3" />

                </LinearLayout>

            </LinearLayout>

            <!-- MENÚ ADMINISTRADOR -->
            <LinearLayout
                android:id="@+id/layoutAdministrador"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- ADMINISTRAR PARTIDOS -->
                <LinearLayout
                    android:id="@+id/opcionAdministrarPartidos"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_menu_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Administrar partidos"
                        android:src="@drawable/ic_soccer"
                        app:tint="#16A7D3" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Administrar partidos"
                        android:textColor="#2196F3"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#2196F3" />

                </LinearLayout>

                <!-- ACTUALIZAR PUNTAJES -->
                <LinearLayout
                    android:id="@+id/opcionActualizarPuntajes"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginBottom="6dp"
                    android:background="@drawable/bg_menu_card"
                    android:clickable="true"
                    android:elevation="2dp"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Actualizar puntajes"
                        android:src="@drawable/ic_trophy"
                        app:tint="#F5A623" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:text="Actualizar puntajes"
                        android:textColor="#2196F3"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="Abrir"
                        android:src="@drawable/ic_arrow_right"
                        app:tint="#2196F3" />

                </LinearLayout>

            </LinearLayout>

            <!-- SALIR -->
            <LinearLayout
                android:id="@+id/opcionSalir"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/bg_menu_card"
                android:clickable="true"
                android:elevation="2dp"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="12dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Salir"
                    android:src="@drawable/ic_logout"
                    app:tint="#2196F3" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:text="Salir"
                    android:textColor="#2196F3"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:contentDescription="Salir"
                    android:src="@drawable/ic_arrow_right"
                    app:tint="#EC168C" />

            </LinearLayout>

        </LinearLayout>

        <!-- ESTADIO INFERIOR -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="210dp"
            android:layout_marginBottom="-2dp"
            android:clipChildren="true"
            android:clipToPadding="true">

            <ImageView
                android:id="@+id/imgEstadioInferior"
                android:layout_width="match_parent"
                android:layout_height="260dp"
                android:layout_gravity="bottom"
                android:contentDescription="Estadio de fútbol"
                android:scaleType="centerCrop"
                android:src="@drawable/estadio_inferior" />

        </FrameLayout>

    </LinearLayout>

</ScrollView>