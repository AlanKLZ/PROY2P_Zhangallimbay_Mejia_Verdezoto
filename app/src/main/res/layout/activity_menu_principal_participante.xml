<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MenuPrincipalParticipante">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="729dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="196dp">

            <ImageView
                android:id="@+id/imageView4"
                android:layout_width="wrap_content"
                android:layout_height="183dp"
                app:srcCompat="@drawable/encabezado_background"
                tools:ignore="ContentDescription,ImageContrastCheck" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="108dp"
                android:layout_gravity="bottom"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/imageView6"
                    android:layout_width="120dp"
                    android:layout_height="80dp"
                    android:layout_weight="0"
                    app:srcCompat="@drawable/baseline_person_24"
                    tools:ignore="ContentDescription,ImageContrastCheck,InefficientWeight"
                    tools:srcCompat="@drawable/baseline_person_24" />

                <LinearLayout
                    android:layout_width="272dp"
                    android:layout_height="match_parent"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/bienvenido" />

                    <TextView
                        android:id="@+id/tvnombreParticipante"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <TextView
                        android:id="@+id/textView7"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:text="@string/participante"
                        android:textColor="#7BBE32"
                        android:textStyle="bold"
                        tools:ignore="TextContrastCheck" />
                </LinearLayout>

            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="334dp"
            android:orientation="vertical"
            android:padding="25dp">

            <Button
                android:id="@+id/btnTablaPosiciones"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="#66FFFFFF"
                android:elevation="3dp"
                android:insetBottom="10dp"
                android:onClick="verTablaPosicion"
                android:text="@string/tabla_de_clasificacion"
                android:textColor="#263238"
                app:strokeColor="#7BBE32"
                app:strokeWidth="2dp"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnPronosticos"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="#FCFAFD"
                android:elevation="3dp"
                android:insetBottom="10dp"
                android:onClick="verPronosticos"
                android:text="@string/pronostico"
                android:textColor="#263238"
                app:strokeColor="#7BBE32"
                app:strokeWidth="2dp"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnMisPronosticos"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="#FCFAFD"
                android:elevation="3dp"
                android:insetBottom="10dp"
                android:onClick="verMisPronosticos"
                android:text="@string/mis_pronosticos"
                android:textColor="#263238"
                app:strokeColor="#7BBE32"
                app:strokeWidth="2dp"
                tools:ignore="VisualLintButtonSize" />

            <Button
                android:id="@+id/btnSalirParticipante"
                style="@style/Widget.Material3.Button.IconButton.Filled.Tonal"
                android:layout_width="match_parent"
                android:layout_height="70dp"
                android:backgroundTint="#FCFAFD"
                android:elevation="3dp"
                android:insetBottom="10dp"
                android:onClick="salir"
                android:text="@string/salir"
                android:textColor="#263238"
                app:strokeColor="#7BBE32"
                app:strokeWidth="2dp"
                tools:ignore="VisualLintButtonSize" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="212dp"
            android:contentDescription="@string/fondo_inferior">

            <ImageView
                android:id="@+id/imageView11"
                android:layout_width="wrap_content"
                android:layout_height="226dp"
                app:srcCompat="@drawable/estadio_inferior"
                tools:ignore="ContentDescription,VisualLintBounds" />
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>